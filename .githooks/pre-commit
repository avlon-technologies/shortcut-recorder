d=$(dirname "$0")
if [ -f "$d/pre-commit.local" ]; then sh "$d/pre-commit.local" "$@" || exit $?; fi
exec node "C:/projects/avlon/continuum/tools/continuum.mjs" guard pre-commit "$@"
